# Copy to .env and fill in. Never commit .env.

# --- LLM providers (you need at least the one you select below) ----------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free option for OpenAI models: GitHub Models. Set OPENAI_API_KEY to a GitHub token
# with the "models" permission and uncomment:
# DEALDESK_OPENAI_BASE_URL=https://models.github.ai/inference

# --- LangSmith tracing and evals ------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dealdesk
# EU-hosted LangSmith accounts use: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- DealDesk -------------------------------------------------------------------------
DEALDESK_ENV=dev
DEALDESK_LLM_PROVIDER=anthropic
# DEALDESK_LLM_MODEL=claude-haiku-5-5
DEALDESK_DATABASE_URL=postgresql+psycopg://dealdesk:dealdesk@localhost:5432/dealdesk
# Works the same with Supabase (use the session pooler connection string), e.g.
# DEALDESK_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DEALDESK_WEBHOOK_SECRET=change-me
# Optional: require an X-API-Key header on /v1 endpoints
# DEALDESK_API_KEY=
DEALDESK_LOG_LEVEL=INFO
DEALDESK_LOG_FORMAT=console
